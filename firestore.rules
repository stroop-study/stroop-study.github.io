rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function connecte() { return request.auth != null; }
    // Identifiant de l'admin : l'appli prépare ces règles avec le bon identifiant.
    function admin() { return connecte() && request.auth.uid == 'ADMIN_UID'; }
    function invite() {
      return admin() || (connecte()
        && request.auth.token.email_verified == true
        && request.auth.token.email.lower() in get(/databases/$(database)/documents/config/acces).data.membres);
    }

    // Progression et réglages : chaque personne ne voit et ne modifie que les siens.
    // L'admin peut les lire (statistiques des testeur·ses, annoncées aux invité·es), jamais les modifier.
    match /users/{userId}/{document=**} {
      allow read: if (connecte() && request.auth.uid == userId) || admin();
      allow write: if connecte() && request.auth.uid == userId;
    }
    // Bibliothèque commune : l'admin écrit, les invités lisent.
    match /bibliotheque/{code} {
      allow read: if invite();
      allow write: if admin();
    }
    // Signalements partagés : chacun·e écrit les siens, l'admin les lit tous et peut les retirer.
    match /signalements/{sid} {
      allow read: if admin();
      allow create, update: if invite() && (admin() || request.resource.data.uid == request.auth.uid);
    }
    // Liste des invités : seule l'admin la voit et la modifie.
    match /config/acces {
      allow read, write: if admin();
    }
  }
}
